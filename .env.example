# ==============================================================================
# AUREUS-SMC Institutional Gold Engine (.env template)
# ==============================================================================

# System Environment (SANDBOX, PAPER, PRODUCTION)
ENVIRONMENT=SANDBOX
LOG_LEVEL=INFO
TIMEZONE=America/New_York

# Asset Specification
SYMBOL=XAUUSD
CONTRACT_SIZE=100.0
TICK_SIZE=0.01
PIP_SIZE=0.10
MIN_LOT=0.01
MAX_LOT=50.0
LOT_STEP=0.01

# SMC Strategy Sessions (EST / EDT Canonical NY Time)
LONDON_SESSION_START=03:00
LONDON_SESSION_END=08:00
NY_EXECUTION_START=08:00
NY_EXECUTION_END=10:30

# SMC Parameters
ATR_PERIOD=14
DISPLACEMENT_ATR_MULTIPLIER=1.5
SWING_LOOKBACK=5
FVG_ENTRY_MODE=50_PERCENT
MIN_FVG_SIZE_POINTS=0.30

# Risk Management
INITIAL_BALANCE=100000.0
RISK_PER_TRADE_PERCENT=1.0
TARGET_RRR=3.0
BREAK_EVEN_RRR=1.5
BE_OFFSET_DOLLARS=0.10
PARTIAL_TP_RRR=2.0
PARTIAL_TP_PERCENT=50.0

# Filters & Circuit Breakers
MAX_ALLOWED_SPREAD_DOLLARS=0.30
MAX_ALLOWED_SLIPPAGE_DOLLARS=0.20
MAX_TRADES_PER_SESSION=2
MAX_DAILY_DRAWDOWN_PERCENT=2.0

# Macroeconomic Filter (ForexFactory / Investing)
NEWS_FILTER_ENABLED=True
NEWS_BLACKOUT_MINUTES_BEFORE=15
NEWS_BLACKOUT_MINUTES_AFTER=15

# Broker Gateway (PAPER, MT5, OANDA)
BROKER_TYPE=PAPER

# MT5 Gateway Credentials (Windows only)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# OANDA v20 Gateway Credentials
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ENVIRONMENT=practice

# Web Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8000
DATABASE_PATH=storage/aureus_trades.db
